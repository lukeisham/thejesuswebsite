# Base URL of the thejesuswebsite JSON API.
#
# Express has no /api prefix. Only nginx and dev-proxy.js add and strip it.
#
#   On the VPS (default):     http://localhost:3000
#   Local, direct to Express: http://localhost:3000
#   Local, via dev-proxy.js:  http://localhost:4179/api
#   Remote, via nginx:        https://thejesuswebsite.org/api
#
API_BASE_URL=https://thejesuswebsite.org/api

# Port for the Streamable HTTP transport (ignored in --stdio mode).
# Default: 3100
#
PORT=3100
